	(text "IO PORTS (6 x IO / VCC / GND)"
		(exclude_from_sim no)
		(at 86.36 33.02 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "de8b1746-0f9e-4d3e-8188-ac843a9d8ba0")
	)
	(text "Per port: pin 3k SIG (330 R in series against shorts and hot-plugging),\n3k-1 VCC (5 V from the buck), 3k-2 GND; e.g. J5A: 3 SIG, 2 VCC, 1 GND.\nIO1-IO4 = GPIO16/21/22/24 (5 V tolerant).\nIO5/IO6 = GPIO26/27 (ADC0/1): 3.3 V logic only.\nServos: drive them from PIO (the motors use PWM slices 0 and 2-7).\nJ5 is one 3 x 6 right-angle header (WingTAT 2011-3X06G00RB) on the board's\nleft end, pins out through the left wall: per port GND (lowest, nearest\nthe wall), 5V (middle), SIG (top)."
		(exclude_from_sim no)
		(at 86.36 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5505e8dc-eaeb-435c-96a7-397d69b2cb57")
	)
