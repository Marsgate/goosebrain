	(footprint "hexy:USB_A_ShouHan_AF90_WJDG"
		(layer "F.Cu")
		(uuid "17eb4c23-31d5-4be0-8641-759b99f889ab")
		(at 148.8 113.3 180)
		(descr "USB 2.0 type A receptacle, right angle, THT, SHOU HAN AF 90 WJDG (LCSC C456018). Contacts dia 0.92 at 2.50/2.00/2.50 mm. Shell tabs 13.14 mm apart; the maker drawing puts them 2.4 mm toward the mouth in dia 2.1 holes, EasyEDA (and the Amphenol/Molex pattern) at 2.71 in dia 2.3, so the holes are 2.3 x 2.6 slots covering both. Mouth 12.8-13.0 mm forward of the contact row.")
