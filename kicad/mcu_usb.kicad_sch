	)
	(text "+3V3 DECOUPLING"
		(exclude_from_sim no)
		(at 33.02 53.34 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "4e071a6c-1c27-40da-abaf-cd675797450a")
	)
	(text "One 100 nF per IOVDD pin (C41-C46), then QSPI_IOVDD (C47),\nUSB_OTP_VDD (C48), ADC_AVDD (C49) and VREG_VIN 4.7 uF (C50).\nPlace each next to its pin."
		(exclude_from_sim no)
		(at 35.56 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ca47d5a4-09bb-47c9-a72e-fcfc070461ba")
	)
	(text "CORE REGULATOR: L3 must be the polarity-marked Abracon\nAOTA-B201610S3R3 (dot = pin 1 = +1V1), as in the RP2350\nhardware design guide. C52 sits at DVDD pin 23;\nC53-C55 at the other DVDD pins. R42/C51 filter VREG_AVDD."
		(exclude_from_sim no)
		(at 210.82 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "73332b8b-aa04-4055-bbb2-e8732c7da794")
	)
	(text "GPIO MAP\nGPIO0-11   motors M1-M6 (each motor's A/B pair shares a PWM slice)\nGPIO12/13  I2C0 SDA/SCL (charger)\nGPIO14     charger /INT\nGPIO15     drivers nSLEEP (all three)\nGPIO16/17  USB-A D+/D- (Pico-PIO-USB, D- = D+ + 1)\nGPIO18     USB-A VBUS enable\nGPIO19     drivers nFAULT (wired-OR, R54 pull-up)\nGPIO20     status LED\nGPIO21     spare\nGPIO22-25  IO1-IO4 (5 V tolerant)\nGPIO26/27  IO5/IO6 (ADC0/1, 3.3 V logic only)\nGPIO28     battery sense (ADC2)\nGPIO29     spare (ADC3)"
		(exclude_from_sim no)
		(at 243.84 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "57f77230-a04f-4102-a076-1d72f5082668")
	)
	(text "USB-C DATA (NATIVE USB)"
		(exclude_from_sim no)
		(at 63.5 127 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b8dab977-1065-49c6-acf4-612583d6a594")
	)
	(text "UF2, Arduino upload and CDC serial over USB-C.\nU6 VBUS pin is on +3V3: it is rated 6 V, so never PD VBUS."
		(exclude_from_sim no)
		(at 63.5 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4a74fc38-49e0-41a4-8b5e-06cfcb24186a")
	)
	(text "BOOT (SW2) pulls QSPI_SS low through R46;\nRESET (SW3) pulls RUN low through R47.\nQSPI clock/data unused: the flash is inside the RP2354A.\nSWD on test pads TP1/TP2."
		(exclude_from_sim no)
		(at 106.68 207.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "da6effb5-fa4b-4277-aeb3-98dc5d5202b2")
	)
	(text "USB-A HOST (2.4 GHz CONTROLLER DONGLE)"
		(exclude_from_sim no)
		(at 307.34 96.52 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d65924d2-e57f-408d-8364-03920a5ceb6a")
	)
	(text "Pico-PIO-USB on GPIO16/17 with 22 R in series (as on\nAdafruit's Feather RP2040 USB Host); firmware enables the\nRP2354's internal pull-downs. U12 limits VBUS to 0.5 A and\nstays off until firmware drives GPIO18 (R50 holds it off)."
		(exclude_from_sim no)
		(at 322.58 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1e894e94-5fd4-49a1-8457-9ed53480c944")
	)
	(text "STATUS LED"
		(exclude_from_sim no)
		(at 266.7 160.02 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "99d7eb08-ae3d-4007-9746-bbaa6fecb18b")
	)
	(text "BATTERY SENSE"
		(exclude_from_sim no)
		(at 284.48 175.26 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b5915763-7f72-4711-b82d-24307028d3dd")
	)
	(text "VSYS / 4.7 into ADC2:\n12.6 V reads as 2.68 V.\nAfter the switch on purpose: no drain when off.\nSwitch off: read the pack from U7's ADC (I2C)."
		(exclude_from_sim no)
		(at 320.04 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "39fa4cbb-42ca-462a-85b2-82d29a7366ff")
	)
	(text "nFAULT PULL-UP"
		(exclude_from_sim no)
		(at 248.92 177.8 0)
